# Runtime for the Android emulator on hosts whose own userland it does not run on (on the
# owner's Fedora 44 machine every emulator build segfaults; inside this image it works, see
# docs/DECISIONS.md D20). The SDK and AVDs are mounted from the host at the same paths.
FROM docker.io/library/ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libx11-6 libx11-xcb1 libxcb1 libxext6 libxrender1 libxi6 libxtst6 libxcomposite1 libxcursor1 \
      libxdamage1 libxrandr2 libxfixes3 libxkbfile1 libxkbcommon0 libxkbcommon-x11-0 libxcb-xinerama0 \
      libpulse0 libasound2t64 libnss3 libnspr4 libdbus-1-3 libgl1 libegl1 libgbm1 libdrm2 \
      libfontconfig1 libfreetype6 libbsd0 libuuid1 libglib2.0-0t64 libsm6 libice6 libtinfo6 \
      libxshmfence1 libvulkan1 ca-certificates \
  && rm -rf /var/lib/apt/lists/*
