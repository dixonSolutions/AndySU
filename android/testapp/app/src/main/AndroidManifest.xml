<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name="com.andysu.host.AndySUApplication"
        android:label="AndySU Test"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity android:name="com.andysu.host.HostActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Test hooks only: adb shell am broadcast -n com.andysu.testapp/.TestCommands -a check -->
        <receiver android:name=".TestCommands" android:exported="true" />
    </application>
</manifest>
