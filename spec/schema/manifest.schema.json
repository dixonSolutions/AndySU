{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dixonsolutions.github.io/AndySU/spec/schema/manifest.schema.json",
  "title": "AndySU update manifest (update.json)",
  "type": "object",
  "required": ["schema", "app", "channel", "issued", "expires", "sequence", "releases"],
  "properties": {
    "schema": { "const": 1 },
    "app": { "$ref": "#/$defs/app" },
    "channel": { "$ref": "#/$defs/channel" },
    "issued": { "$ref": "#/$defs/time" },
    "expires": { "$ref": "#/$defs/time" },
    "sequence": { "$ref": "#/$defs/u53" },
    "releases": { "type": "array", "items": { "$ref": "#/$defs/release" }, "maxItems": 256 }
  },
  "$defs": {
    "app": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$", "maxLength": 255 },
    "channel": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "u53": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "abi": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" },
    "url": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "urls": { "type": "array", "items": { "$ref": "#/$defs/url" }, "maxItems": 16 },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*/$)(?!.*//)(?!.*\\\\)(?!(.*/)?\\.\\.?(/|$))[^\\u0000]+$"
    },
    "release": {
      "type": "object",
      "required": ["id", "sequence", "components"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$" },
        "sequence": { "$ref": "#/$defs/u53" },
        "requires": {
          "type": "object",
          "properties": {
            "host_api_min": { "$ref": "#/$defs/u53" },
            "shell_min": { "$ref": "#/$defs/u53" },
            "api_min": { "$ref": "#/$defs/u53" },
            "abis": { "type": "array", "items": { "$ref": "#/$defs/abi" }, "maxItems": 16 }
          }
        },
        "rollout": {
          "type": "object",
          "required": ["percent"],
          "properties": {
            "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
            "salt": { "type": "string", "maxLength": 128 }
          }
        },
        "mandatory": { "type": "boolean" },
        "notes_url": { "$ref": "#/$defs/url" },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/component" },
          "contains": { "type": "object", "properties": { "path": { "const": "andysu-payload.json" } }, "required": ["path"] }
        },
        "shell": {
          "type": "object",
          "required": ["version_code", "sha256", "size"],
          "properties": {
            "version_code": { "$ref": "#/$defs/u53" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "size": { "$ref": "#/$defs/u53" },
            "urls": { "$ref": "#/$defs/urls" }
          }
        }
      }
    },
    "component": {
      "type": "object",
      "required": ["name", "kind", "path", "sha256", "size"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "kind": { "enum": ["content", "dex", "native"] },
        "apply": { "enum": ["hot", "restart"], "default": "restart" },
        "abi": { "$ref": "#/$defs/abi" },
        "path": { "$ref": "#/$defs/path" },
        "archive": { "enum": ["zip"] },
        "unpacked_size": { "$ref": "#/$defs/u53" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "$ref": "#/$defs/u53" },
        "urls": { "$ref": "#/$defs/urls" },
        "deltas": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["from_sha256", "format", "sha256", "size"],
            "properties": {
              "from_sha256": { "$ref": "#/$defs/sha256" },
              "format": { "enum": ["zstd", "bsdiff"] },
              "sha256": { "$ref": "#/$defs/sha256" },
              "size": { "$ref": "#/$defs/u53" },
              "urls": { "$ref": "#/$defs/urls" }
            }
          }
        }
      }
    }
  }
}
